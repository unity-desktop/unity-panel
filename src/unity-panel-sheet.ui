<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="UnityPanelSheet" parent="UnityWindow">
    <property name="namespace">unity-panel-sheet</property>
    <property name="stylesheet">/org/unity/panel/style.css</property>
    <property name="anchor">top|bottom|left|right</property>
    <property name="layer">top</property>
    <property name="exclusivity">ignore</property>
    <property name="keymode">on-demand</property>
    <property name="content">
      <object class="UnityEdgeSheet" id="sheet">
        <property name="edge">top</property>
        <property name="full-length">false</property>
        <property name="show-drag-handle">false</property>
        <property name="modal">true</property>
        <property name="inset">6</property>
        <signal name="notify::open" handler="open_cb" swapped="true"/>
        <signal name="notify::sheet-size" handler="sheet_size_cb" swapped="true"/>
        <property name="sheet">
          <object class="GtkBox" id="body">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkCenterBox">
                <property name="margin-top">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-bottom">12</property>
                <property name="start-widget">
                  <object class="AdwToggleGroup" id="pages"/>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwViewStack" id="stack">
                <property name="vhomogeneous">false</property>
                <property name="enable-transitions">true</property>
                <binding name="visible-child-name">
                  <lookup name="active-name">pages</lookup>
                </binding>
                <child>
                  <object class="UnityPanelQuickSettingsPage"/>
                </child>
                <child>
                  <object class="UnityPanelCalendarPage"/>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
