<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="UnityPanelCalendarPage" parent="AdwBin">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkCalendar" id="calendar">
            <property name="show-day-names">true</property>
            <property name="margin-start">6</property>
            <property name="margin-end">6</property>
            <property name="margin-bottom">6</property>
            <signal name="notify::date" handler="date_cb" swapped="true"/>
          </object>
        </child>
        <child>
          <object class="GtkActionBar">
            <child type="start">
              <object class="GtkLabel" id="date">
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <property name="margin-start">6</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="open">
                <property name="icon-name">org.unity.panel.calendar-symbolic</property>
                <property name="tooltip-text" translatable="yes">Open Calendar</property>
                <signal name="clicked" handler="open_clicked_cb" swapped="true"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
