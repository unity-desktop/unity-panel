<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwToggle" id="toggle">
    <property name="name">calendar</property>
    <property name="icon-name">org.unity.panel.calendar-symbolic</property>
    <property name="tooltip" translatable="yes">Calendar</property>
  </object>
</interface>
