<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="UnityPanelNetwork" id="network"/>
  <template class="UnityPanelNetworkIcon" parent="AdwBin">
    <property name="visible" bind-source="network" bind-property="available" bind-flags="sync-create"/>
    <property name="child">
      <object class="GtkImage">
        <property name="icon-name" bind-source="network" bind-property="icon-name" bind-flags="sync-create"/>
      </object>
    </property>
  </template>
</interface>
