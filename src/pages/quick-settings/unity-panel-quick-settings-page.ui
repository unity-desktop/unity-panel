<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="UnityPanelQuickSettingsPage" parent="AdwBin">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkFlowBox">
                <property name="min-children-per-line">3</property>
                <property name="max-children-per-line">3</property>
                <property name="homogeneous">true</property>
                <property name="column-spacing">12</property>
                <property name="row-spacing">12</property>
                <property name="selection-mode">none</property>
                <style>
                  <class name="tiles"/>
                </style>
                <child>
                  <object class="GtkFlowBoxChild">
                    <property name="focusable">false</property>
                    <property name="visible" bind-source="power_saver" bind-property="visible" bind-flags="sync-create"/>
                    <property name="child">
                      <object class="UnityPanelPowerProfilesTile" id="power_saver">
                        <property name="profile">power-saver</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkFlowBoxChild">
                    <property name="focusable">false</property>
                    <property name="visible" bind-source="performance" bind-property="visible" bind-flags="sync-create"/>
                    <property name="child">
                      <object class="UnityPanelPowerProfilesTile" id="performance">
                        <property name="profile">performance</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkActionBar"/>
        </child>
      </object>
    </property>
  </template>
</interface>
